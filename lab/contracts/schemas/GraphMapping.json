{
  "$defs": {
    "IdentifierLink": {
      "description": "A shared identifier: an account links to it, and accounts that share one are linked for communities.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "device",
            "email",
            "address",
            "phone",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "rel_type": {
          "title": "Rel Type",
          "type": "string"
        }
      },
      "required": [
        "rel_type",
        "label",
        "key",
        "kind"
      ],
      "title": "IdentifierLink",
      "type": "object"
    }
  },
  "properties": {
    "account_key": {
      "default": "account_id",
      "title": "Account Key",
      "type": "string"
    },
    "account_label": {
      "default": "Account",
      "title": "Account Label",
      "type": "string"
    },
    "account_opened": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "opened",
      "title": "Account Opened"
    },
    "identifiers": {
      "items": {
        "$ref": "#/$defs/IdentifierLink"
      },
      "title": "Identifiers",
      "type": "array"
    },
    "payment_amount": {
      "default": "amount",
      "title": "Payment Amount",
      "type": "string"
    },
    "payment_key": {
      "default": "tx_id",
      "title": "Payment Key",
      "type": "string"
    },
    "payment_time": {
      "default": "ts",
      "title": "Payment Time",
      "type": "string"
    },
    "payment_type": {
      "default": "TX",
      "title": "Payment Type",
      "type": "string"
    }
  },
  "title": "GraphMapping",
  "type": "object"
}
