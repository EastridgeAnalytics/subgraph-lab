# subgraph-lab settings (page 07). Copy to .env. Every LAB_* number below is a default you can change.

# The master graph. Leave NEO4J_URI unset to use the bundled Neo4j (docker compose --profile local up).
# For Aura: NEO4J_URI=neo4j+s://<id>.databases.neo4j.io and the password from the Aura console.
# NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=subgraph-lab
NEO4J_DATABASE=neo4j
# The http(s) Query API relate pull and push use. Derived from NEO4J_URI when unset.
# NEO4J_QUERY_URI=

# Summaries through the Anthropic API. Unset: the agent writes them through describe_alert, else the template.
# ANTHROPIC_API_KEY=
LAB_MODEL=claude-sonnet-5-5

# Judgment numbers
LAB_SEARCH_K=50
LAB_SEARCH_HOPS=1
LAB_SLICE_CAP=200000
LAB_PUSH_BATCH=5000
LAB_LOAD_START_ROWS=20000
LAB_SUMMARY_COMMUNITIES=20
LAB_SUMMARY_ALERTS=50
LAB_SUMMARY_WORDS=120
LAB_LOUVAIN_RESOLUTION=1.0
LAB_COMPONENT_MIN=30
LAB_WEIGHT_DEVICE=3.0
LAB_WEIGHT_EMAIL=2.0
LAB_WEIGHT_ADDRESS=1.5
LAB_WEIGHT_PAYMENT=1.0
LAB_WEIGHT_PHONE=2.0
LAB_WEIGHT_OTHER=1.0
LAB_SEED=42
LAB_DELTA_SAMPLE=1000
LAB_EMBEDDING_DIM=64
LAB_SHARED_MAX=50
LAB_KEY_BATCH=500
# The account summary's phrases (page 02)
LAB_NEW_ACCOUNT_DAYS=60
LAB_ROUND_THRESHOLD=10000
LAB_JUST_UNDER=0.05
# Communities, velocity and evidence (wave 5: out of the code, into settings)
LAB_CYCLE_MAX_LENGTH=6
LAB_CYCLE_COUNT_CAP=1000
LAB_VELOCITY_HOLDOUT_DAYS=14
LAB_VELOCITY_MIN_HISTORY_DAYS=28
LAB_VELOCITY_MIN_ACTIVE_DAYS=3
LAB_SUMMARY_SMALL_GROUP=8
LAB_EVIDENCE_TOP_MEMBERS=5
LAB_EVIDENCE_MAX_IDENTIFIERS=10
LAB_EVIDENCE_MAX_IDS=10

# Host ports. Change them when another Neo4j already uses the defaults.
LAB_PORT=8000
LAB_RELATE_BOLT_PORT=7687
LAB_RELATE_HTTP_PORT=7474
LAB_RELATE_MCP_PORT=7475
LAB_NEO4J_BOLT_PORT=17687
LAB_NEO4J_HTTP_PORT=17474

# Relate's telemetry switch. Always on.
DO_NOT_TRACK=1
